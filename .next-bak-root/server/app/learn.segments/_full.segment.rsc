0:{"P":null,"c":["","learn"],"q":"","i":false,"f":[[["",{"children":["learn",{"children":["__PAGE__",{},"$undefined","$undefined",4608]},"$undefined","$undefined",4608]},"$undefined","$undefined",4624],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/3qgedu2m9j26n.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","script","script-0",{"src":"/_next/static/chunks/3fntmmi971322.js","async":true,"nonce":"$undefined"}],["$","script","script-1",{"src":"/_next/static/chunks/0q9zhqq61k74y.js","async":true,"nonce":"$undefined"}]],["$","html",null,{"lang":"id","className":"inter_fe8b9d92-module__LINzvG__variable manrope_d246d8a-module__CWRIVa__variable","children":["$","body",null,{"children":[["$","$L2",null,{}],["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}],["$","footer",null,{"className":"footer","children":[["$","$L5",null,{"className":"brand","href":"/","children":[["$","$L6",null,{"className":"footer-brand-mark","src":"/logo-choicelens.png","alt":"ChoiceLens","width":33,"height":35}],["$","span",null,{"children":["Choice",["$","span",null,{"children":"Lens"}]]}]]}],["$","p",null,{"children":"Real data. Clear insights. Better choices."}],["$","div",null,{"style":{"display":"flex","gap":14,"alignItems":"center","flexWrap":"wrap"},"children":[["$","$L5",null,{"href":"/compare","style":{"color":"inherit","textDecoration":"none"},"children":"Compare"}],["$","$L5",null,{"href":"/learn","style":{"color":"inherit","textDecoration":"none"},"children":"Learn"}],["$","$L5",null,{"href":"/category/smartphones","style":{"color":"inherit","textDecoration":"none"},"children":"Smartphones"}],["$","span",null,{"children":"© 2026 ChoiceLens"}]]}]]}]]}]}]]}],{"children":[["$","$1","c",{"children":[null,["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":[["$","$1","c",{"children":[["$","main",null,{"className":"section","children":[["$","div",null,{"style":{"marginBottom":18},"children":[["$","nav",null,{"aria-label":"Breadcrumb","style":{"fontSize":11,"color":"#94a3b8","marginBottom":10},"children":[["$","span","Home",{"children":[false,["$","$L5",null,{"href":"/","style":{"color":"#2563eb","textDecoration":"none"},"children":"Home"}]]}],["$","span","Learn",{"children":[["$","span",null,{"style":{"margin":"0 6px"},"children":"/"}],["$","span",null,{"style":{"color":"#475569"},"children":"Learn"}]]}]]}],["$","div",null,{"className":"section-head","style":{"marginBottom":0},"children":[["$","div",null,{"children":[["$","h2",null,{"children":"More Than Just Specs"}],["$","p",null,{"children":"Pahami istilah, material, dan teknologi yang sering kamu temui."}]]}],"$undefined"]}]]}],["$","$L7",null,{"items":[{"slug":"amoled","title":"AMOLED","desc":"Layar lebih hidup, kontras lebih tinggi, dan lebih hemat daya.","kind":"Teknologi layar","example":"Contoh: Galaxy S25 Ultra, Pixel 8","audience":["smartphones"],"icon":"▣","artClass":"gradient-screen","chapters":[{"heading":"Apa itu AMOLED?","body":"AMOLED (Active-Matrix Organic Light-Emitting Diode) adalah teknologi layar di mana setiap piksel menyala dengan cahayanya sendiri. Karena tidak butuh backlight di belakang layar, hitam bisa benar-benar gelap dan warna terlihat lebih hidup dibanding layar LCD biasa."},{"heading":"Kenapa penting untukmu?","body":"Kontras yang tinggi membuat video dan foto jauh lebih dramatis. Piksel yang mati saat menampilkan warna hitam juga menghemat daya — makin banyak konten gelap, makin hemat baterai."},{"heading":"Kekurangannya","body":"Bahan organik pada piksel bisa mengalami burn-in bila layar menampilkan elemen statis dalam waktu lama. Pilih AMOLED yang sudah dilengkapi teknologi pengatur piksel modern untuk meminimalkan risiko ini."}]},{"slug":"ltpo","title":"LTPO","desc":"Refresh rate adaptif untuk performa dan daya tahan baterai yang lebih baik.","audience":["smartphones"],"kind":"Teknologi layar","example":"Contoh: iPhone 16 Pro, Galaxy S25 Ultra","icon":"▤","artClass":"layers","chapters":[{"heading":"Teknologi refresh rate adaptif","body":"LTPO (Low-Temperature Polycrystalline Oxide) memungkinkan layar mengubah refresh rate secara dinamis — dari 1 Hz hingga 120 Hz. Layar diam mungkin hanya berjalan 1–10 Hz, sedangkan saat scrolling game turun naik mengikuti konten."},{"heading":"Penghematan baterai yang nyata","body":"Refresh rate rendah saat aktivitas statis berarti panel lebih jarang 'bangun'. Kamu tetap mendapat kelancaran 120 Hz tanpa mengorbankan daya tahan baterai sepanjang hari."},{"heading":"Biasa ditemukan di mana?","body":"LTPO biasanya ada di flagship premium seperti iPhone Pro dan Galaxy Ultra. Kalau refresh rate adaptif adalah prioritasmu, periksa apakah panel perangkat mendukung LTPO, bukan sekadar 120 Hz statis."}]},{"slug":"peba","title":"PEBA","desc":"Bahan midsole premium yang lebih ringan, empuk, dan responsif.","kind":"Material sepatu","example":"Contoh: Nike ZoomX Vaporfly, Saucony Endorphin","audience":["shoes"],"icon":"◌","artClass":"foam","chapters":[{"heading":"Apa itu PEBA?","body":"PEBA (Polyether Block Amide) adalah bahan polimer yang dipakai pada midsole sepatu lari dan basket kelas atas. Dibanding EVA atau TPU konvensional, PEBA jauh lebih ringan sekaligus lebih elastis."},{"heading":"Kenapa lari terasa lebih cepat","body":"Sifat elastis PEBA mengembalikan energi dengan lebih efisien, sehingga setiap langkah terasa 'memantulkan'. Bahan ini juga lebih empuk tanpa menambah bobot — kombinasi ideal untuk pelari jarak jauh."},{"heading":"Kekurangannya","body":"Harganya lebih mahal karena proses produksinya kompleks. Beberapa varian PEBA juga bisa terasa kurang stabil di tikungan, sehingga biasanya dipadukan dengan plate atau frame kaku."}]},{"slug":"carbon-fiber","title":"Carbon Fiber","desc":"Material kuat, ringan, dan fleksibel untuk performa maksimal.","kind":"Material sepatu & laptop","example":"Contoh: pelat karbon Nike Alphafly, rangka laptop premium","audience":["shoes","laptops"],"icon":"✥","artClass":"carbon","chapters":[{"heading":"Serat yang mengubah desain","body":"Carbon fiber adalah material dari serat karbon yang disusun dan diawetkan dengan resin. Hasilnya sangat kaku dan ringan — itulah kenapa ia dipakai pada sepatu lari, rangka laptop, hingga bodi mobil balap."},{"heading":"Peran pada sepatu dan laptop","body":"Di sepatu lari, plate carbon fiber bekerja seperti tuas yang mendorong kaki maju dan memangkas energi. Di laptop, cover carbon fiber memberi kekuatan dengan bobot jauh lebih ringan dari aluminium."},{"heading":"Kenapa mahal?","body":"Proses produksinya bersifat kompleks dan setiap lembar serat harus ditata presisi. Itu sebabnya produk carbon fiber premium dijual dengan harga lebih tinggi — sebagai imbalannya kamu dapat rasio kekuatan-berat terbaik yang ada."}]},{"slug":"chip-3nm","title":"Chip 3nm","desc":"Chipset generasi fabrikasi 3 nanometer: lebih kencang sekaligus lebih hemat daya.","kind":"Teknologi chipset","example":"Contoh: A18 Pro, Snapdragon 8 Elite","audience":["smartphones"],"icon":"⚙","artClass":"layers","chapters":[{"heading":"Apa arti angka 3nm?","body":"Angka nanometer (nm) menunjukkan ukuran transistor di dalam chip — makin kecil, makin banyak transistor yang muat di ruang yang sama. Chip 3nm seperti A18 Pro dan Snapdragon 8 Elite memadatkan miliaran transistor lebih banyak dibanding generasi 5nm atau 7nm."},{"heading":"Kenapa penting untukmu?","body":"Transistor yang lebih rapat berarti dua hal sekaligus: performa lebih tinggi untuk game dan AI, plus konsumsi daya lebih rendah untuk tugas yang sama. Itu sebabnya flagship terbaru terasa lebih kencang tanpa baterai yang lebih boros."},{"heading":"Batasannya","body":"Fabrikasi 3nm mahal dan rumit, jadi hanya dipakai di chip flagship. Chip kelas menengah masih memakai 4–6nm — tetap kencang untuk harian, hanya kalah efisien di beban berat."}]},{"slug":"kamera-periskop","title":"Kamera Periskop","desc":"Lensa zoom yang dilipat di dalam bodi agar bisa memotret jauh tanpa bodi tebal.","kind":"Teknologi kamera","example":"Contoh: Galaxy S25 Ultra, iPhone 15 Pro Max","audience":["smartphones"],"icon":"◉","artClass":"gradient-screen","chapters":[{"heading":"Apa itu kamera periskop?","body":"Kamera periskop membelokkan cahaya 90 derajat lewat prisma, lalu melewatkannya sepanjang bodi ponsel sebelum sampai ke sensor. Trik ini memberi ruang untuk lensa zoom optik 5x atau lebih tanpa membuat bodi HP menebal."},{"heading":"Beda dengan zoom digital","body":"Zoom optik memperbesar lewat lensa sehingga detail tetap tajam, sedangkan zoom digital hanya memotong dan memperbesar piksel. Klaim seperti 100x Space Zoom adalah kombinasi optik + digital + AI — makin jauh, makin besar peran software."},{"heading":"Batasannya","body":"Lensa periskop butuh cahaya cukup; di kondisi gelap hasilnya bisa kalah dari kamera utama. Modulnya juga mahal dan memakan ruang, jadi hanya ada di varian Ultra/Pro Max."}]},{"slug":"rangka-titanium","title":"Rangka Titanium","desc":"Bodi ponsel dari titanium: sekuat baja tapi jauh lebih ringan.","kind":"Material bodi","example":"Contoh: iPhone 16 Pro, Galaxy S25 Ultra","audience":["smartphones"],"icon":"⬢","artClass":"carbon","chapters":[{"heading":"Kenapa titanium?","body":"Titanium punya rasio kekuatan-berat yang sangat baik — hampir sekuat baja tapi sekitar 40% lebih ringan. Flagship seperti iPhone 16 Pro dan Galaxy S25 Ultra memakainya agar bodi besar tetap nyaman digenggam."},{"heading":"Kelebihan yang terasa","body":"Bobot turun jelas dibanding rangka stainless steel, sekaligus lebih tahan bengkok dibanding aluminium biasa. Finishing-nya juga memberi kesan premium yang jadi ciri flagship."},{"heading":"Batasannya","body":"Titanium sulit dibentuk dan mahal diproduksi, sehingga hanya muncul di varian termahal. Ia juga bukan anti-gores — tetap butuh case kalau kamu khawatir bodi lecet."}]},{"slug":"kaca-pelindung","title":"Kaca Pelindung","desc":"Kaca layar yang diperkuat secara kimiawi agar tahan jatuh dan gores.","kind":"Material layar","example":"Contoh: Ceramic Shield (iPhone), Gorilla Armor (Galaxy S25 Ultra)","audience":["smartphones"],"icon":"◇","artClass":"gradient-screen","chapters":[{"heading":"Beda dengan kaca biasa","body":"Kaca pelindung seperti Ceramic Shield dan Gorilla Armor diperkuat lewat proses kimia yang menanamkan tekanan di permukaan. Hasilnya jauh lebih tahan retak saat jatuh dibanding kaca standar — meski memakai nama dagang berbeda, prinsipnya sama."},{"heading":"Kenapa tetap butuh pelindung?","body":"Tahan jatuh bukan berarti anti-gores. Pasir dan debu di saku tetap bisa meninggalkan goresan halus. Kaca pelindung menaikkan batas aman, bukan menghilangkannya."},{"heading":"Trade-off-nya","body":"Semakin keras kaca, biasanya semakin rentan pecah saat benturan titik tertentu — dan sebaliknya. Produsen menyeimbangkan kekerasan anti-gores dengan kelenturan anti-pecah di tiap generasi."}]},{"slug":"wireless-charging","title":"Wireless Charging","desc":"Isi daya tanpa kabel lewat induksi magnet — praktis, termasuk MagSafe.","kind":"Teknologi daya","example":"Contoh: MagSafe (iPhone), Wireless PowerShare (Galaxy)","audience":["smartphones","laptops"],"icon":"⚡","artClass":"foam","chapters":[{"heading":"Cara kerjanya","body":"Charging pad mengalirkan arus ke kumparan yang menimbulkan medan magnet, lalu kumparan di dalam HP mengubahnya kembali jadi listrik. MagSafe di iPhone menambahkan magnet agar posisi kumparan selalu presisi."},{"heading":"Kenapa praktis?","body":"Tinggal tempel tanpa colok-cabut kabel — cocok di meja kerja atau mobil. Galaxy bahkan bisa berbagi daya ke earbuds atau jam lewat Wireless PowerShare."},{"heading":"Batasannya","body":"Lebih lambat dan lebih panas dibanding kabel, dan sebagian energi terbuang sebagai panas. Untuk isi cepat sebelum pergi, kabel + fast charging tetap juaranya."}]},{"slug":"ip68","title":"IP68","desc":"Sertifikasi tahan debu dan air — dengan syarat dan batas yang jelas.","kind":"Ketahanan","example":"Contoh: iPhone 16 Pro, Galaxy S25 Ultra","audience":["smartphones"],"icon":"💧","artClass":"gradient-screen","chapters":[{"heading":"Arti angka 6 dan 8","body":"IP68 terdiri dari dua angka: 6 berarti kedap debu total, 8 berarti tahan direndam air tawar hingga kedalaman dan durasi tertentu sesuai uji lab (umumnya 1,5–6 meter selama 30 menit, tergantung merek)."},{"heading":"Yang tidak dicover","body":"Uji lab memakai air tawar bersih dan kondisi statis — bukan air laut, kolam berklorin, atau air panas. Kerusakan akibat cairan juga umumnya tidak ditanggung garansi, jadi IP68 adalah jaring pengaman, bukan undangan berenang."},{"heading":"Ketahanan yang menurun","body":"Segel anti-air bisa melemah seiring usia, benturan, dan servis. HP dua tahun yang masih berlabel IP68 belum tentu setahan saat baru keluar dari kotak."}]},{"slug":"night-mode","title":"Night Mode","desc":"Foto malam yang terang berkat gabungan banyak frame dan AI.","kind":"Teknologi kamera","example":"Contoh: Pixel 8 Night Sight, iPhone Night mode","audience":["smartphones"],"icon":"🌙","artClass":"gradient-screen","chapters":[{"heading":"Cara kerjanya","body":"Night mode mengambil banyak foto dengan exposure berbeda dalam beberapa detik, lalu menggabungkannya lewat komputasi — seperti yang dipopulerkan Night Sight di Pixel. Hasilnya: foto malam yang terang tanpa flash."},{"heading":"Kenapa jadi pembeda?","body":"Kualitas foto malam kini lebih ditentukan software dibanding ukuran sensor. Dua HP dengan megapiksel sama bisa berbeda jauh hasilnya hanya karena racikan night mode-nya."},{"heading":"Batasannya","body":"Objek bergerak cepat bisa blur karena butuh waktu ambil frame, dan hasilnya kadang terlihat terlalu 'dipoles' dibanding suasana aslinya. Untuk aksi cepat, mode normal + cahaya cukup tetap lebih baik."}]},{"slug":"fast-charging","title":"Fast Charging","desc":"Isi daya berdaya besar agar penuh dalam puluhan menit.","kind":"Teknologi daya","example":"Contoh: Galaxy S25 Ultra 45W, iPhone 20W+ via USB-C","audience":["smartphones","laptops"],"icon":"🔌","artClass":"foam","chapters":[{"heading":"Arti angka watt","body":"Angka watt (mis. 45W) menunjukkan kecepatan isi maksimal yang didukung HP — tapi hanya tercapai dengan charger dan kabel yang kompatibel. Galaxy S25 Ultra mendukung 45W, sedangkan iPhone mengisi sekitar 20W ke atas lewat USB-C."},{"heading":"Kenapa tidak selalu maksimal?","body":"Kecepatan isi melambat drastis setelah 80% untuk melindungi baterai. Klaim 'penuh 30 menit' biasanya diukur dari kondisi hampir kosong dengan charger bawaan."},{"heading":"Efek ke umur baterai","body":"Panas adalah musuh baterai. Fast charging yang sering dipakai penuh mempercepat penurunan kapasitas — untuk pemakaian santai semalaman, isi lambat justru lebih awet."}]},{"slug":"vapor-chamber","title":"Vapor Chamber","desc":"Penyebar panas pipih agar performa HP stabil saat gaming.","kind":"Pendingin","example":"Contoh: Galaxy S25 Ultra","audience":["smartphones"],"icon":"❄","artClass":"carbon","chapters":[{"heading":"Cara kerjanya","body":"Vapor chamber adalah pelat pipih berisi cairan yang menguap saat kena panas chip lalu mengembun di area dingin — menyebar panas jauh lebih merata dibanding pelat grafit biasa. Galaxy S25 Ultra memakainya untuk menjaga performa game."},{"heading":"Efek yang terasa","body":"HP tidak cepat throttling (menurunkan performa karena panas), jadi frame rate game lebih stabil di sesi panjang. Bodi tetap menghangat — hanya panasnya tersebar, bukan menumpuk di satu titik."},{"heading":"Batasannya","body":"Vapor chamber membuang panas lebih baik, bukan menghilangkan panas. Di ruangan panas atau casing tebal, manfaatnya berkurang. Komponen ini juga menambah biaya, jadi absen di HP murah."}]},{"slug":"usb-c","title":"USB-C","desc":"Satu colokan universal untuk isi daya, data, dan layar.","kind":"Konektivitas","example":"Contoh: iPhone 15 ke atas, Galaxy S series","audience":["smartphones","laptops"],"icon":"🔗","artClass":"layers","chapters":[{"heading":"Kenapa sekarang seragam?","body":"Regulasi Uni Eropa mewajibkan USB-C di perangkat baru, sehingga iPhone 15 ke atas ikut beralih dari Lightning. Satu kabel kini bisa dipakai lintas HP, laptop, dan aksesori."},{"heading":"Bentuk sama, kecepatan beda","body":"Colokan USB-C yang sama bisa membawa kecepatan berbeda: USB 2.0 lambat di model dasar, USB 3/Thunderbolt kencang di model Pro. Kabelnya pun menentukan — kabel murah bisa membatasi kecepatan dan daya."},{"heading":"Yang perlu diperhatikan","body":"Selalu cek spesifikasi port dan kabelnya, bukan bentuknya. Untuk transfer file besar atau monitor eksternal, pastikan kabel mendukung standar yang dibutuhkan."}]}]}]]}],["$L8"],"$L9"]}],{},null,false,null]},null,false,"$a"]},null,false,null],"$Lb",false]],"m":"$undefined","G":["$c",["$Ld"]],"S":true,"h":null,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"qAeBMQ8uu4lWN96U-BA9A"}
